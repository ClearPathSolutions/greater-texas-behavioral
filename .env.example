# ---------------------------------------------------------------------------
# Greater Texas Behavioral — environment variables
#
# Copy to .env.local for development and mirror in Vercel:
#   Project → Settings → Environment Variables
# Nothing here is required for the site to build or render.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Clarion Labs — webchat + lead capture (PRIMARY lead path)
#
# The insurance form calls window.ClarionForms.submit() directly and awaits the
# response; see components/VerifyForm.tsx. The cpx_ site key is PUBLIC and
# already shipped in lib/site.ts, so both vars below are OPTIONAL — set them
# only to override the shipped values (e.g. after a key rotation).
#
# IMPORTANT: In Clarion → Settings → Website Integrations, allowlist every
# origin verbatim (apex + www + the .vercel.app alias + any custom domain).
# A non-allowlisted origin returns 403; preview/branch URLs will 403. When that
# happens the form now falls back to /api/lead below instead of silently
# discarding the lead — but the primary path should still be fixed.
# ---------------------------------------------------------------------------

# Optional override of the public Clarion site key.
# Read ONLY by lib/clarion-blog.ts (the server-side blog fetch). It does not
# rotate the key used by the browser scripts or the lead route — those take the
# shipped value from lib/site.ts.
CLARION_SITE_KEY=

# CLARION_API was listed here but is read by NOTHING: the API base comes from
# `clarion.api` in lib/site.ts. Setting it has no effect. Change lib/site.ts
# instead. Left documented rather than deleted so nobody re-adds it expecting
# it to work.


# ---------------------------------------------------------------------------
# Resend — /api/lead FALLBACK delivery
#
# app/api/lead/route.ts is the safety net for when Clarion cannot confirm a
# submission (script blocked by a tracker blocker, origin not allowlisted,
# network failure). It emails the lead to admissions via Resend.
#
# WITHOUT these three set, the route accepts and logs the lead but reports
# delivered:false — which makes the form show the "call us instead" message
# rather than a false confirmation. SET THESE BEFORE LAUNCH so the fallback can
# actually deliver.
# ---------------------------------------------------------------------------

# Get a key at https://resend.com → API Keys
RESEND_API_KEY=

# Verified sender on your Resend domain, e.g.
# CONTACT_FROM="Greater Texas Behavioral <admissions@greatertexasbehavioral.com>"
CONTACT_FROM=

# Where inquiries are delivered (defaults to site.email if unset)
CONTACT_TO=info@greatertexasbehavioral.com


# ---------------------------------------------------------------------------
# Quadrant support portal — "Our Team" staff feed
#
# components/StaffGrid.tsx reads published staff bios from the support portal.
# Optional: set only to point at a non-production portal environment.
# Defaults to https://support.quadranthealthgroup.com
# ---------------------------------------------------------------------------

STAFF_FEED_ORIGIN=
